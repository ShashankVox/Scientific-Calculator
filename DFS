#include <stdio.h>

int visited[10], graph[10][10], n;

void dfs(int node) {
    printf("%d ", node);
    visited[node] = 1;

    for(int i = 0; i < n; i++) {
        if(graph[node][i] == 1 && !visited[i])
            dfs(i);
    }
}

int main() {
    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(int i = 0; i < n; i++)
        for(int j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("DFS Traversal starting from vertex 0: ");
    dfs(0);

    return 0;
}
